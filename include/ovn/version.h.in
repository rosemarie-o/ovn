#ifndef OVN_VERSION_H
#define OVN_VERSION_H 1

#ifndef __has_feature
# define __has_feature(x) 0
#endif
#if __has_feature(address_sanitizer) && defined(__SANITIZE_ADDRESS__)
# define ASAN ASAN
#endif
#ifndef __has_feature
# define __has_feature(x) 0
#endif
#if __has_feature(undefined_behavior_sanitizer)
# define UBSAN UBSAN
#endif

#define OVN_PACKAGE_STRING  "@PACKAGE_STRING@"
#ifdef ASAN
#define OVN_PACKAGE_VERSION "@PACKAGE_VERSION@@VERSION_SUFFIX@ ASAN UBSAN"
#else
#define OVN_PACKAGE_VERSION "@PACKAGE_VERSION@@VERSION_SUFFIX@"
#endif

#define OVN_LIB_VERSION     @LT_CURRENT@
#define OVN_LIB_REVISION    @LT_REVISION@
#define OVN_LIB_AGE         @LT_AGE@

#endif /* ovn/version.h */
